{
  "betterAlign.alignAfterTypeEnter": false,
  "betterAlign.operatorPadding": "right",
  "betterAlign.surroundSpace": {
    "colon": [
      -1,
      1
    ],
    "assignment": [
      1,
      1
    ],
    "arrow": [
      1,
      1
    ],
    "comment": 2
  },
  "editor.tabSize": 2,
  "files.associations": {
    "**/docs/*.md": "liquid",
    "**/docs/**/*.html": "liquid",
    "**/docs/README.md": "markdown",
    "**/src/*.md": "liquid",
    "**/src/**/*.html": "liquid",
    "**/src/README.md": "markdown",
    ".editorconfig": "editorconfig",
    ".env.example": "dotenv",
    "*.hcl": "terraform",
    "*.json.tftpl": "jsonc",
    "*.symlink": "shellscript",
    "**/*.github.io/*.md": "liquid",
    "**/*.github.io/**/*.html": "liquid",
    "**/*.github.io/CONTRIBUTING.md": "markdown",
    "**/*.github.io/README.md": "markdown",
    "Brewfile.symlink": "ruby",
    "CODEOWNERS": "ignore",
    "config": "editorconfig",
    "Dockerfile.*": "dockerfile",
    "gitconfig.symlink": "editorconfig",
    "gitconfig.symlink.example": "editorconfig"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "html.format.templating": true,
  "html.format.unformatted": "pre,samp",
  // "java.format.settings.profile": "GoogleStyle",
  // "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "markdown.styles": [
    "https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.8.1/github-markdown-light.min.css"
  ],
  "markdownTablePrettify.columnPadding": 0,
  "markdownTablePrettify.maxTextLength": 2000000,
  "opentofu.experimentalFeatures.prefillRequiredFields": true,
  "opentofu.experimentalFeatures.validateOnSave": true,
  "prettier.jsxSingleQuote": true,
  "prettier.printWidth": 100,
  "prettier.singleQuote": true,
  "python.languageServer": "Default",
  "search.exclude": {
    "**/_site": true,
    "**/.bundle": true,
    "**/.jekyll-cache": true,
    "**/.jekyll-metadata": true,
    "**/.sass-cache": true,
    "**/*.log": true,
    "**/*.tmp": true,
    "**/bower_components": true,
    "**/node_modules": true,
    "**/Thumbs.db": true,
    "**/tmp": true,
    "**/vendor/bundle": true,
    "**/vendor/cache": true,
    "**/vendor/gem-cache": true,
    "**/vendor/gems": true,
    "**/vendor/ruby": true
  },
  "selectline.alignment": "right",
  "selectline.displayFormat": "%d Lines Selected",
  "selectline.statusbarPriority": 1000,
  "sonarlint.automaticAnalysis": false,
  "sonarlint.rules": {
    "Web:TableWithoutCaptionCheck": {
      "level": "off"
    },
    "Web:BoldAndItalicTagsCheck": {
      "level": "off"
    }
  },
  "[css][sass][scss]": {
    "editor.defaultFormatter": "sibiraj-s.vscode-scss-formatter",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": true
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
    // "editor.defaultFormatter": "Robinsstudio.prettier-java-formatter"
    // ,
    // "editor.formatOnSave": true
  },
  "[javascript|javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true,
    "editor.detectIndentation": false
  },
  "[markdown]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "files.trimTrailingWhitespace": false,
    "multiFormatter.formatterList": [
      "esbenp.prettier-vscode",
      "darkriszty.markdown-table-prettify"
    ],
    "editor.formatOnSave": true
  },
  "[opentofu][opentofu-vars]": {
    "editor.defaultFormatter": "opentofu.vscode-opentofu",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.formatOnSave": true
  },
  "[terragrunt]": {
    "editor.defaultFormatter": "SeemsCloud.terragrunt-hcl-formatter",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file"
  },
  "[typescript|typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  }
}
